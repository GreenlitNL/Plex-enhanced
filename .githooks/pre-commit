#!/usr/bin/env bash
# Git pre-commit hook: Blocks accidental commits of secrets, tokens, or environment files

FORBIDDEN_PATTERNS=(
  "\.env(\..+)?$"
  "local\.properties$"
  "google-services\.json$"
  "auth\.json$"
  "recorded-steps\.js$"
  "\.pem$"
  "\.key$"
  "id_rsa"
)

EXEMPT_PATTERN="\.env\.example$"

STAGED_FILES=$(git diff --cached --name-only)

for file in $STAGED_FILES; do
  if [[ "$file" =~ $EXEMPT_PATTERN ]]; then
    continue
  fi
  for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
    if echo "$file" | grep -Eq "$pattern"; then
      echo ""
      echo "================================================================================"
      echo "❌ [Security Hook Error] Accidental secret or private credential commit blocked!"
      echo "   Forbidden staged file: $file"
      echo "================================================================================"
      echo "👉 ACTION REQUIRED:"
      echo "   Unstage this sensitive file before committing:"
      echo "     git reset HEAD \"$file\""
      echo "================================================================================"
      echo ""
      exit 1
    fi
  done
done

exit 0

